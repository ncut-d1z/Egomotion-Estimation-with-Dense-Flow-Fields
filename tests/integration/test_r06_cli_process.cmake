    message(FATAL_ERROR "CTest must unset display service variables")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(root "${SANDBOX}/CLI 中文 空格/${CASE}_${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse evidence directory: ${root}")
endif()
file(MAKE_DIRECTORY "${root}/origin" "${root}/evidence")
file(WRITE "${root}/evidence/build-mode.txt" "SVG_ENABLED=${SVG_ENABLED}\nDISPLAY=unset\nWAYLAND_DISPLAY=unset\n")
file(WRITE "${root}/BOUNDED_TEST_ONLY.txt" "R6 CLI integration; Bias seed7 level0..2; no full scientific experiment.\n")
set(archive "${SOURCE_ROOT}/origin/egomotion_estimation_dense_flow_fields_matlab_scripts")
file(GLOB_RECURSE originals LIST_DIRECTORIES false "${archive}/*")
function(snapshot out)
    set(digests "")
    foreach(path IN LISTS originals)
        file(SHA256 "${path}" hash)
        string(APPEND digests "${hash}  ${path}\n")
    endforeach()
    set(${out} "${digests}" PARENT_SCOPE)
endfunction()
snapshot(before)
file(WRITE "${root}/evidence/originals-before.sha256" "${before}")
set_property(GLOBAL PROPERTY CLI_CALL_COUNT 0)

function(equal actual expected reason)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${reason}: expected [${expected}], got [${actual}]")
    endif()
endfunction()
function(field json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    equal("${error}" NOTFOUND "JSON field ${ARGN}")
    equal("${actual}" "${expected}" "JSON field ${ARGN}")
endfunction()
function(invoke label expected)
    get_property(count GLOBAL PROPERTY CLI_CALL_COUNT)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY CLI_CALL_COUNT ${count})
    set(log "${root}/evidence/${count}-${label}")
    string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${log}.meta" "source_sha=${SOURCE_SHA}\ncwd=${root}\nstart=${start}\nexecutable=${CLI}\n")
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.meta" "argv=${arg}\n")
    endforeach()
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 45)
    string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${log}.meta" "end=${end}\nexit=${status}\nexpected_exit=${expected}\n")
    file(WRITE "${log}.stdout" "${stdout}")
    file(WRITE "${log}.stderr" "${stderr}")
    equal("${status}" "${expected}" "${label} exit; evidence ${log}")
    if(expected EQUAL 0)
        equal("${stderr}" "" "${label} success stderr")
    else()
        equal("${stdout}" "" "${label} failure stdout")
        field("${stderr}" "${expected}" exit_code)
    endif()
    set(output "${stdout}" PARENT_SCOPE)
    set(diagnostic "${stderr}" PARENT_SCOPE)
    set(actual_status "${status}" PARENT_SCOPE)
    message(STATUS "${label}: exit=${status}, log=${log}")
endfunction()
function(parse_failure label)
    invoke("${label}" 2 ${ARGN})
    field("${diagnostic}" ExperimentErrorCode error_domain)
    field("${diagnostic}" InvalidParameters error_code)
    field("${diagnostic}" parse stage)
endfunction()
function(no_output reason)
    if(EXISTS "${root}/output")
        message(SEND_ERROR "${reason}: read/parse operation created output/")
    endif()
endfunction()
function(inspect path variable dimensions)
    invoke(inspect 0 inspect-mat --file "${path}" --variable "${variable}")
    if(NOT output MATCHES "^variable=${variable} class=6 type=[0-9]+ rank=2 dims=${dimensions} ")
        message(SEND_ERROR "Unexpected metadata: ${output}")
    endif()
endfunction()
function(check_manifest id kind source_blob)
    file(READ "${root}/output/${id}/manifest.json" manifest)
    field("${manifest}" egomotion-run-manifest-v1 schema)
    field("${manifest}" "${SOURCE_SHA}" repo_sha)
    field("${manifest}" "${source_blob}" source_blob_sha)
    field("${manifest}" "${id}" run_id)
    field("${manifest}" "${kind}" experiment_kind)
    field("${manifest}" Complete completeness)
    field("${manifest}" 7 algorithm_rng_seed)
    foreach(key IN ITEMS expected_repetitions attempted completed)
        field("${manifest}" 1 ${key})
    endforeach()
    field("${manifest}" 9 valid)
    field("${manifest}" 0 failed)
    field("${manifest}" 0 undefined)
    string(JSON count LENGTH "${manifest}" mat_files)
    equal("${count}" 7 "Exact source save set")
    set(names "")
    foreach(index RANGE 0 6)
        string(JSON entry GET "${manifest}" mat_files ${index})
        string(JSON name GET "${entry}" variable)
        list(APPEND names "${name}")
        field("${entry}" "${name}.mat" file)
        file(SHA256 "${root}/output/${id}/${name}.mat" hash)
        file(SIZE "${root}/output/${id}/${name}.mat" bytes)
        field("${entry}" "${hash}" sha256)
        field("${entry}" "${bytes}" bytes)
        if(name STREQUAL xwerte)
            inspect("${root}/output/${id}/${name}.mat" "${name}" 3x1)
        else()
            inspect("${root}/output/${id}/${name}.mat" "${name}" 3x3)
        endif()
    endforeach()
    list(SORT names)
    equal("${names}" "xwerte;ywerte1;ywerte2;ywerte3;ywerte4;ywerte5;ywerte6" "Current source fields only")
    file(GLOB files LIST_DIRECTORIES false RELATIVE "${root}/output/${id}" "${root}/output/${id}/*")
    list(LENGTH files count)
    equal("${count}" 8 "Seven MAT and one Manifest, no staging files")
endfunction()

function(process_contract)
    invoke(help 0 --help)
    if(NOT output MATCHES "Usage: egomotion")
        message(SEND_ERROR "Missing executable help")
    endif()
    # CLI LLD §1 明确要求所有已知子命令的 --help 均无副作用、退出0。
    foreach(command IN ITEMS inspect-mat run-bias-occluded run-bias-proportional
            run-adaptive-init run-adaptive-comparison run-adaptive-update-rates analyze plot)
        invoke("help-${command}" 0 "${command}" --help)
        if(NOT output MATCHES "Usage: egomotion")
            message(SEND_ERROR "${command} help did not print usage")
        endif()
    endforeach()
    invoke(version 0 --version)
    if(NOT output MATCHES "egomotion 0.1.0")
        message(SEND_ERROR "Unexpected executable version: ${output}")
    endif()
    parse_failure(unknown unknown)
    parse_failure(unknown-help unknown --help)
    parse_failure(help-with-extra inspect-mat --help --file absent)
    parse_failure(duplicate inspect-mat --file absent --file another)
    parse_failure(seed-overflow run-bias-occluded --seed 4294967296 --level 2)
    parse_failure(negative-level run-bias-occluded --seed 7 --level -1)
    parse_failure(output-root run-bias-occluded --seed 7 --level 2 --output-root elsewhere)
    parse_failure(runid-traversal run-adaptive-init --run-id ../origin)
    parse_failure(noise-nan run-adaptive-comparison --noise-scale NaN)
    parse_failure(inspect-mode inspect-mat --file absent --mode strict)
    set(missing "${root}/缺少\"反斜线\\文件.mat")
    invoke(missing-mat 3 inspect-mat --file "${missing}")
    field("${diagnostic}" MatErrorCode error_domain)
    field("${diagnostic}" MissingFile error_code)
    field("${diagnostic}" "${missing}" path)
    set(input "${archive}/bias_test/produced_data/occluded_regions/1/xwerte.mat")
    inspect("${input}" xwerte 10x1)
    invoke(missing-variable 3 inspect-mat --file "${input}" --variable absent)
    field("${diagnostic}" MissingVariable error_code)
    field("${diagnostic}" absent variable)
    invoke(missing-analysis 3 analyze --experiment adaptive-init --input-root "${root}/absent")
    field("${diagnostic}" AnalysisErrorCode error_domain)
    field("${diagnostic}" MissingResult error_code)
    field("${diagnostic}" MatErrorCode causes 0 domain)
    no_output("Help, parse, inspect and missing analysis")

    invoke(bias-occluded 0 run-bias-occluded --seed 7 --level 2 --run-id explicit_bias)
    field("${output}" Complete status)
    field("${output}" explicit_bias run_id)
    check_manifest(explicit_bias bias-occluded 00a3e974fbf068ccd1af4e541a659862beffcad5)
    file(SHA256 "${root}/output/explicit_bias/manifest.json" manifest_before)
    invoke(duplicate-runid 6 run-bias-occluded --seed 7 --level 2 --run-id explicit_bias)
    field("${diagnostic}" MatErrorCode error_domain)
    field("${diagnostic}" OutputExists error_code)
    file(SHA256 "${root}/output/explicit_bias/manifest.json" manifest_after)
    equal("${manifest_after}" "${manifest_before}" "Duplicate RunId preserves Manifest")

    invoke(bias-proportional 0 run-bias-proportional --seed 7 --level 2)
    field("${output}" Complete status)
    string(JSON id GET "${output}" run_id)
    string(LENGTH "${id}" id_length)
    if(NOT id MATCHES "^run_[0-9a-f]+$" OR NOT id_length EQUAL 36)
        message(SEND_ERROR "Invalid OS-generated RunId: ${id}")
    endif()
    check_manifest("${id}" bias-proportional fc3c4f0a7a417171415fb5e3d869a744ba24d04f)
    # 使用刚生成的合法三行结果走真实分析器，验证输出根和输入根不会混淆。
    invoke(bounded-analysis 0 analyze --experiment bias --input-root "${root}/output/${id}")
    field("${output}" egomotion-analysis-v1 schema)
    string(JSON count LENGTH "${output}" curves)
    equal("${count}" 13 "Bounded Bias analysis curve count")
    field("${output}" 96 curves 0 x 0)
endfunction()

function(archive_case label experiment relative expected_curves source_blob panels)
    set(input "${archive}/${relative}")
    set(plot_exit 7)
    if(SVG_ENABLED)
        set(plot_exit 0)
    endif()
    file(GLOB output_before LIST_DIRECTORIES true "${root}/output/*")
    invoke("analyze-${label}" 0 analyze --experiment "${experiment}" --input-root "${input}")
    file(GLOB output_after LIST_DIRECTORIES true "${root}/output/*")
    equal("${output_after}" "${output_before}" "Analyze must not create outputs")
    if(NOT "${actual_status}" STREQUAL "0")
        # invoke已经登记原失败；继续取得其它输入的实际证据，不让JSON解析掩盖后续情境。
        invoke("plot-${label}" "${plot_exit}" plot --experiment "${experiment}" --input-root "${input}" --run-id "plot_${label}")
        return()
    endif()
    field("${output}" egomotion-analysis-v1 schema)
    field("${output}" "${source_blob}" source_analysis_blob)
    string(JSON count LENGTH "${output}" curves)
    equal("${count}" "${expected_curves}" "${label} source curve count")
    math(EXPR last "${count}-1")
    set(unknown_hashes 0)
    foreach(index RANGE 0 ${last})
        string(JSON curve GET "${output}" curves ${index})
        # 成功历史入口为Bias/Initialization，均未调用平滑辅助函数。
        string(JSON helpers LENGTH "${curve}" helper_source_blob_shas)
        equal("${helpers}" 0 "${label} must not claim an unused smoothing helper")
        string(JSON xs LENGTH "${curve}" x)
        string(JSON ys LENGTH "${curve}" y)
        equal("${xs}" "${ys}" "${label} x/y lengths")
        if(xs LESS 1)
            message(SEND_ERROR "${label} unexpectedly empty curve ${index}")
        endif()
        string(JSON begin GET "${curve}" source_begin_matlab)
        string(JSON end GET "${curve}" source_end_matlab)
        math(EXPR length "${end}-${begin}+1")
        equal("${xs}" "${length}" "${label} inclusive MATLAB range")
        if(experiment STREQUAL bias)
            equal("${begin}" 3 "Bias source start row")
            equal("${end}" 10 "Bias archived end row")
            # 独立L2字节审计固定末轮归档值，不能用当前生成脚本公式覆盖历史横轴。
            field("${curve}" "${ARGV6}" x 0)
            field("${curve}" "${ARGV7}" x 7)
        else()
            math(EXPR final "${xs}-1")
            field("${curve}" "${begin}" x 0)
            field("${curve}" "${end}" x ${final})
        endif()
        string(JSON inputs GET "${curve}" inputs)
        string(JSON members LENGTH "${inputs}")
        if(experiment STREQUAL bias AND index GREATER 0)
            equal("${members}" 41 "40 numbered Bias members plus last x")
        endif()
        math(EXPR last_input "${members}-1")
        foreach(member RANGE 0 ${last_input})
            string(JSON item GET "${inputs}" ${member})
            string(JSON path GET "${item}" path)
            string(JSON variable GET "${item}" variable)
            string(FIND "${path}" "${input}/" prefix)
            equal("${prefix}" 0 "Contributor stays in selected input root")
            if(NOT EXISTS "${path}")
                message(FATAL_ERROR "Missing contributing source ${path}")
            endif()
            get_filename_component(filename "${path}" NAME)
            equal("${filename}" "${variable}.mat" "Contributor variable identity")
            file(SHA256 "${path}" actual_hash)
            string(JSON hash_type TYPE "${item}" mat_sha256)
            equal("${hash_type}" STRING "Production Reader must bind a sealed MAT digest")
            field("${item}" "${actual_hash}" mat_sha256)
        endforeach()
    endforeach()
    file(APPEND "${root}/evidence/coverage.txt" "${label}: curves=${count}; unknown JSON input hashes=${unknown_hashes}\n")
    # analyze无写操作；此前plot输出存在时也不得产生额外目录。
    file(GLOB output_before LIST_DIRECTORIES true "${root}/output/*")
    invoke("repeat-analyze-${label}" 0 analyze --experiment "${experiment}" --input-root "${input}")
    file(GLOB output_after LIST_DIRECTORIES true "${root}/output/*")
    equal("${output_after}" "${output_before}" "Analyze must not create outputs")
    invoke("plot-${label}" "${plot_exit}" plot --experiment "${experiment}" --input-root "${input}" --run-id "plot_${label}")
    if(NOT SVG_ENABLED)
        field("${diagnostic}" Bootstrap error_domain)
        field("${diagnostic}" BackendUnavailable error_code)
        field("${diagnostic}" plot stage)
        file(GLOB output_after LIST_DIRECTORIES true "${root}/output/*")
        equal("${output_after}" "${output_before}" "Absent SVG backend must not reserve a RunId")
        return()
    endif()
    field("${output}" "plot_${label}" run_id)
    string(JSON files LENGTH "${output}" plot_files)
    equal("${files}" "${panels}" "${label} SVG panel count")
    math(EXPR last_file "${files}-1")
    foreach(index RANGE 0 ${last_file})
        string(JSON filename GET "${output}" plot_files ${index})
        if(NOT filename MATCHES "^[a-z-]+[.]svg$")
            message(FATAL_ERROR "Unsafe plot file identity: ${filename}")
        endif()
        file(READ "${root}/output/plot_${label}/${filename}" svg)
        if(NOT svg MATCHES "^<svg " OR NOT svg MATCHES "</svg>" OR
           NOT svg MATCHES "<polyline " OR NOT svg MATCHES "${source_blob}")
            message(SEND_ERROR "${label}: missing SVG structure/curve/source identity")
        endif()
    endforeach()
endfunction()

function(nonfinite_archive_case label experiment)
    set(input "${archive}/adaptive_matched_filter_test/produced_data/${label}")
    file(GLOB before_outputs LIST_DIRECTORIES true "${root}/output/*")
    foreach(command IN ITEMS analyze plot)
        set(options --experiment "${experiment}" --input-root "${input}")
        if(command STREQUAL "plot")
            list(APPEND options --run-id "rejected_${label}")
        endif()
        invoke("${command}-${label}" 5 "${command}" ${options})
        field("${diagnostic}" AnalysisErrorCode error_domain)
        field("${diagnostic}" NonFiniteInput error_code)
        field("${diagnostic}" analyze stage)
        field("${diagnostic}" "${input}/allemitrotfehler.mat" path)
        field("${diagnostic}" allemitrotfehler variable)
    endforeach()
    file(GLOB after_outputs LIST_DIRECTORIES true "${root}/output/*")
    equal("${after_outputs}" "${before_outputs}" "Non-finite source cannot publish a plot")
    file(APPEND "${root}/evidence/coverage.txt" "${label}: analyze/plot rejected NonFiniteInput, no plot published\n")
endfunction()

if("${CASE}" STREQUAL "contract")
