cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/artifact_record_checks.cmake")
# 固定有限 MAT -> 真实 CLI -> 独立多项式参考；不运行 MATLAB 或完整实验。
foreach(required IN ITEMS CLI FIXTURE SANDBOX SOURCE_SHA SVG_ENABLED)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(DEFINED ENV{DISPLAY} OR DEFINED ENV{WAYLAND_DISPLAY})
    message(FATAL_ERROR "CTest must unset display service variables")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(root "${SANDBOX}/有限输入 中文/${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse ${root}")
endif()
file(MAKE_DIRECTORY "${root}/origin" "${root}/evidence")
file(WRITE "${root}/evidence/build-mode.txt" "SVG_ENABLED=${SVG_ENABLED}\nDISPLAY=unset\nWAYLAND_DISPLAY=unset\n")
function(equal actual expected reason)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${reason}: expected [${expected}], got [${actual}]")
    endif()
endfunction()
function(invoke label expected_exit executable)
    set(log "${root}/evidence/${label}")
    string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${log}.meta" "source_sha=${SOURCE_SHA}\ncwd=${root}\nstart=${start}\nexecutable=${executable}\nseed=none\n")
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.meta" "argv=${arg}\n")
    endforeach()
    execute_process(COMMAND "${executable}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 45)
    string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${log}.meta" "end=${end}\nexit=${status}\nexpected_exit=${expected_exit}\n")
    file(WRITE "${log}.stdout" "${stdout}")
    file(WRITE "${log}.stderr" "${stderr}")
    equal("${status}" "${expected_exit}" "${label} exit; evidence ${log}")
    if(expected_exit EQUAL 0)
        equal("${stderr}" "" "${label} stderr")
    else()
        equal("${stdout}" "" "${label} failure stdout")
        string(JSON code GET "${stderr}" error_code)
        equal("${code}" BackendUnavailable "${label} missing backend")
        string(JSON code GET "${stderr}" exit_code)
        equal("${code}" "${expected_exit}" "${label} diagnostic exit")
        string(JSON stage GET "${stderr}" stage)
        equal("${stage}" plot "${label} diagnostic stage")
    endif()
    set(output "${stdout}" PARENT_SCOPE)
    set(actual_status "${status}" PARENT_SCOPE)
    message(STATUS "${label}: exit=${status}; evidence ${log}")
endfunction()
invoke(fixture 0 "${FIXTURE}" "${root}")
if(NOT "${actual_status}" STREQUAL "0")
    message(FATAL_ERROR "Fixture failed; original evidence retained")
endif()
file(GLOB_RECURSE fixture_files LIST_DIRECTORIES false "${root}/output/*.mat")
list(LENGTH fixture_files file_count)
equal("${file_count}" 8 "Synthetic MAT count")
foreach(path IN LISTS fixture_files)
    file(SHA256 "${path}" hash)
    list(APPEND before_hashes "${hash}")
    file(APPEND "${root}/evidence/inputs-before.sha256" "${hash}  ${path}\n")
endforeach()

function(check_dataset id experiment expected_count expected_points expected_full)
    file(GLOB before_outputs LIST_DIRECTORIES true "${root}/output/*")
    invoke("analyze-${id}" 0 "${CLI}" analyze --experiment "${experiment}" --input-root "${root}/output/${id}")
    file(GLOB after_outputs LIST_DIRECTORIES true "${root}/output/*")
    equal("${after_outputs}" "${before_outputs}" "Analyze creates no output directory")
    if(NOT "${actual_status}" STREQUAL "0")
        return()
    endif()
    file(READ "${root}/evidence/${id}.expected.json" expected)
    foreach(key IN ITEMS schema source_analysis_blob)
        string(JSON want GET "${expected}" "${key}")
        string(JSON actual GET "${output}" "${key}")
        equal("${actual}" "${want}" "${id} ${key}")
    endforeach()
    string(JSON count LENGTH "${output}" curves)
    equal("${count}" "${expected_count}" "${id} curve count")
    math(EXPR last "${expected_count}-1")
    set(points 0)
    set(full_points 0)
    foreach(index RANGE 0 ${last})
        string(JSON actual GET "${output}" curves ${index})
        string(JSON want GET "${expected}" curves ${index})
        # 数值oracle与Reader无关；使用CMake独立摘要填充该固定输入的字节身份。
        string(JSON inputs LENGTH "${want}" inputs)
        math(EXPR last_input "${inputs}-1")
        foreach(member RANGE 0 ${last_input})
            string(JSON path GET "${want}" inputs ${member} path)
            file(SHA256 "${path}" digest)
            string(JSON want SET "${want}" inputs ${member} mat_sha256 "\"${digest}\"")
        endforeach()
        string(JSON expected SET "${expected}" curves ${index} "${want}")
        # 比较整个对象，防止未列举字段的意外 schema 漂移。
        string(JSON same EQUAL "${actual}" "${want}")
        if(NOT same)
            foreach(key IN ITEMS id panel x_unit y_unit x_scale y_scale source_begin_matlab
                    source_end_matlab smoothing_half_window x y smoothing_full helper_source_blob_shas inputs)
                string(JSON a GET "${actual}" "${key}")
                string(JSON b GET "${want}" "${key}")
                if(NOT "${a}" STREQUAL "${b}")
                    message(SEND_ERROR "${id} curve ${index} differs: ${key}; see actual/expected JSON in ${root}/evidence")
                endif()
            endforeach()
            message(SEND_ERROR "${id} curve ${index}: exact independent object comparison failed")
        endif()
        string(JSON n LENGTH "${actual}" y)
        math(EXPR points "${points}+${n}")
        string(JSON n LENGTH "${actual}" smoothing_full)
        math(EXPR full_points "${full_points}+${n}")
    endforeach()
    equal("${points}" "${expected_points}" "${id} plotted sample count")
    equal("${full_points}" "${expected_full}" "${id} full smoothing sample count")
    file(WRITE "${root}/evidence/${id}.bound.expected.json" "${expected}\n")
    file(APPEND "${root}/evidence/coverage.txt" "${id}: curves=${count}; xy_pairs=${points}; smoothing_full=${full_points}; exact JSON comparison; independent input digests bound and retained\n")
    set(plot_exit 7)
    if(SVG_ENABLED)
        set(plot_exit 0)
    endif()
    invoke("plot-${id}" "${plot_exit}" "${CLI}" plot --experiment "${experiment}" --input-root "${root}/output/${id}" --run-id "plot_${id}")
    if(NOT SVG_ENABLED)
        file(GLOB after_outputs LIST_DIRECTORIES true "${root}/output/*")
        equal("${after_outputs}" "${before_outputs}" "Missing SVG backend creates no output directory")
        return()
    endif()
    if(NOT "${actual_status}" STREQUAL "0")
        return()
    endif()
    string(JSON source_blob GET "${expected}" source_analysis_blob)
    check_artifact_execution("${root}" "plot_${id}" "${source_blob}"
        plot --experiment "${experiment}" --input-root "${root}/output/${id}" --run-id "plot_${id}")
    artifact_field("${recorded_artifact_invocation}" "${experiment}" effective_config experiment)
    check_artifact_inputs("${recorded_artifact_invocation}" "${expected}")
    string(JSON count LENGTH "${output}" plot_files)
    equal("${count}" 2 "${id} SVG panel count")
    foreach(index RANGE 0 1)
        string(JSON filename GET "${output}" plot_files ${index})
        if(NOT filename MATCHES "^(rotation|translation)[.]svg$")
            message(FATAL_ERROR "Unexpected SVG identity ${filename}")
        endif()
        file(READ "${root}/output/plot_${id}/${filename}" svg)
        string(JSON blob GET "${expected}" source_analysis_blob)
        if(NOT svg MATCHES "^<svg " OR NOT svg MATCHES "</svg>" OR
           NOT svg MATCHES "<polyline " OR NOT svg MATCHES "${blob}")
            message(SEND_ERROR "${id}: SVG structure/source missing")
        endif()
        if("${experiment}" STREQUAL "adaptive-update-rates")
            if(NOT svg MATCHES ">Y</text>" OR svg MATCHES "log10")
                message(SEND_ERROR "${id}: source plot requires linear axes")
            endif()
            string(REGEX MATCHALL "helper [.]m blob: eced66659205a6386ec84723e37a46517d06c017" helpers "${svg}")
            list(LENGTH helpers helper_count)
            if(filename STREQUAL "rotation.svg")
                equal("${helper_count}" 12 "Four segments times three smoothing helpers")
            else()
                equal("${helper_count}" 3 "Three translation smoothing helpers")
            endif()
        elseif(NOT svg MATCHES ">log10[(]Y[)]</text>")
            message(SEND_ERROR "${id}: source Comparison requires logarithmic y axis")
        endif()
        if("${experiment}" STREQUAL "adaptive-comparison" AND svg MATCHES "helper [.]m blob:")
            message(SEND_ERROR "Comparison SVG must not claim smoothing helper provenance")
        endif()
    endforeach()
endfunction()
check_dataset(comparison_fixture adaptive-comparison 12 2650 0)
check_dataset(rates_fixture adaptive-update-rates 20 2928 3460)
foreach(path IN LISTS fixture_files)
    file(SHA256 "${path}" hash)
    list(APPEND after_hashes "${hash}")
    file(APPEND "${root}/evidence/inputs-after.sha256" "${hash}  ${path}\n")
endforeach()
equal("${after_hashes}" "${before_hashes}" "CLI preserves all synthetic MAT bytes")
