cmake_minimum_required(VERSION 3.28)
foreach(required IN ITEMS PROBE FAULT_LIBRARY SOURCE_ROOT SOURCE_SHA SANDBOX)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(root "${SANDBOX}/探针 中文/${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse evidence")
endif()
file(MAKE_DIRECTORY "${root}/evidence" "${root}/empty" "${root}/invalid")
set(archive "${SOURCE_ROOT}/origin/egomotion_estimation_dense_flow_fields_matlab_scripts")
set(subset "${archive}/adaptive_matched_filter_test/produced_data/initialization")
file(GLOB_RECURSE inputs LIST_DIRECTORIES false "${archive}/*.mat")
foreach(path IN LISTS inputs)
    file(SHA256 "${path}" digest)
    list(APPEND before "${digest}")
    file(APPEND "${root}/evidence/inputs-before.sha256" "${digest}  ${path}\n")
endforeach()
function(equal actual expected reason)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${reason}: expected [${expected}], got [${actual}]")
    endif()
endfunction()
function(contains text needle reason)
    string(FIND "${text}" "${needle}" position)
    if(position LESS 0)
        message(SEND_ERROR "${reason}: missing [${needle}]")
    endif()
endfunction()
set_property(GLOBAL PROPERTY DICTIONARY_CALLS 0)
function(invoke label expected channel)
    get_property(count GLOBAL PROPERTY DICTIONARY_CALLS)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY DICTIONARY_CALLS ${count})
    set(log "${root}/evidence/${count}-${label}")
    string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${log}.meta" "source_sha=${SOURCE_SHA}\ncwd=${root}\nstart=${start}\nexecutable=${PROBE}\nmode=${channel}\nseed=not_applicable\n")
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.meta" "argv=${arg}\n")
    endforeach()
    if(channel STREQUAL full)
        file(APPEND "${log}.meta" "stderr=/dev/full (not captured)\n")
        execute_process(COMMAND "${PROBE}" ${ARGN} WORKING_DIRECTORY "${root}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_FILE /dev/full TIMEOUT 90)
        set(diagnostic "")
    elseif(channel MATCHES "^fault-(write|close)$")
        set(operation "${CMAKE_MATCH_1}")
        list(GET ARGN 1 report)
        file(APPEND "${log}.meta" "LD_PRELOAD=${FAULT_LIBRARY}\nEGOMOTION_TEST_REPORT_PATH=${report}\nEGOMOTION_TEST_REPORT_FAULT=${operation}\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LD_PRELOAD=${FAULT_LIBRARY}"
            "EGOMOTION_TEST_REPORT_PATH=${report}" "EGOMOTION_TEST_REPORT_FAULT=${operation}"
            "${PROBE}" ${ARGN} WORKING_DIRECTORY "${root}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 90)
        contains("${diagnostic}" "INJECT dictionary report ${operation} EIO"
            "The target report fault must actually fire")
        contains("${diagnostic}" "Report ${operation} failure" "Report fault classification")
    else()
        execute_process(COMMAND "${PROBE}" ${ARGN} WORKING_DIRECTORY "${root}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 90)
    endif()
    string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${log}.meta" "end=${end}\nexit=${status}\nexpected_exit=${expected}\n")
    file(WRITE "${log}.stdout" "${output}")
    if(NOT channel STREQUAL full)
        file(WRITE "${log}.stderr" "${diagnostic}")
    endif()
    equal("${status}" "${expected}" "${label}: exit; evidence=${log}")
    equal("${output}" "" "Probe must keep status/diagnostics off stdout")
    set(error "${diagnostic}" PARENT_SCOPE)
endfunction()

invoke(archive-default 0 normal "${archive}" "${root}/archive.md" --source-sha "${SOURCE_SHA}")
equal("${error}" "scanned=582, ok=582, failed=0, variables=582\n" "Original archive decoded")
file(READ "${root}/archive.md" report)
contains("${report}" "**全部 582 个 MAT 文件读取成功。**" "Default count contract")
contains("${report}" "Source SHA（执行参数）: ${SOURCE_SHA}" "Supplied source identity")
invoke(subset-default 1 normal "${subset}" "${root}/count.md")
equal("${error}" "scanned=4, ok=4, failed=0, variables=4\n" "Actual count retained")
invoke(subset-success 0 normal "${subset}" "${root}/success.md" --expected-count 4)
invoke(status-full 2 full "${subset}" "${root}/status-full.md" --expected-count 4)
file(SHA256 "${root}/success.md" successful_report)
file(SHA256 "${root}/status-full.md" delivered_report)
equal("${delivered_report}" "${successful_report}" "Status failure preserves exact report")
invoke(count-status-full 2 full "${subset}" "${root}/count-full.md")
file(SHA256 "${root}/count.md" count_report)
file(SHA256 "${root}/count-full.md" count_full)
equal("${count_full}" "${count_report}" "Incomplete report retained on status failure")
invoke(usage 2 normal)
contains("${error}" "Usage: mat_data_dict_probe" "Usage diagnostic")
invoke(usage-full 2 full)
invoke(missing-source 2 normal "${root}/missing" "${root}/missing.md")
contains("${error}" "MAT_ROOT is not a directory" "Missing source classification")
invoke(empty-source 1 normal "${root}/empty" "${root}/empty.md" --expected-count 1)
equal("${error}" "scanned=0, ok=0, failed=0, variables=0\n" "Empty source not success")
file(WRITE "${root}/invalid/broken.mat" "not a MAT container\n")
file(SHA256 "${root}/invalid/broken.mat" broken_before)
invoke(corrupt-source 1 normal "${root}/invalid" "${root}/corrupt.md" --expected-count 1)
contains("${error}" "scanned=1, ok=0, failed=1, variables=0" "Decode failure count")
file(READ "${root}/corrupt.md" report)
contains("${report}" "OPEN_FAILED" "Corrupt input report")
file(SHA256 "${root}/invalid/broken.mat" broken_after)
equal("${broken_after}" "${broken_before}" "Corrupt input preserved")
invoke(inside-source 2 normal "${root}/invalid" "${root}/invalid/report.md")
contains("${error}" "Report must be outside original data" "Input/output boundary")
if(EXISTS "${root}/invalid/report.md")
    message(SEND_ERROR "Rejected report wrote into input")
endif()
invoke(existing-report 2 normal "${subset}" "${root}/success.md" --expected-count 4)
file(SHA256 "${root}/success.md" existing_report)
equal("${existing_report}" "${successful_report}" "No implicit overwrite")
invoke(replace-generated 0 normal "${subset}" "${root}/success.md"
    --expected-count 4 --replace-generated --source-sha replacement-fixture)
file(READ "${root}/success.md" report)
contains("${report}" "Source SHA（执行参数）: replacement-fixture" "Explicit generated replacement")
file(WRITE "${root}/human.md" "Human content\n")
invoke(replace-human 2 normal "${subset}" "${root}/human.md" --expected-count 4 --replace-generated)
file(READ "${root}/human.md" report)
equal("${report}" "Human content\n" "Refuse non-generated replacement")
file(CREATE_LINK "${root}/human.md" "${root}/linked.md" SYMBOLIC)
invoke(symlink-report 2 normal "${subset}" "${root}/linked.md" --expected-count 4 --replace-generated)
contains("${error}" "Refusing output report symlink" "No report symlink following")
file(READ "${root}/human.md" report)
equal("${report}" "Human content\n" "Symlink target preserved")
invoke(report-write 2 fault-write "${subset}" "${root}/write-failed.md" --expected-count 4)
invoke(report-close 2 fault-close "${subset}" "${root}/close-failed.md" --expected-count 4)
file(SHA256 "${root}/close-failed.md" close_report)
equal("${close_report}" "${successful_report}" "Close failure keeps existing complete bytes")
foreach(path IN LISTS inputs)
    file(SHA256 "${path}" digest)
    list(APPEND after "${digest}")
    file(APPEND "${root}/evidence/inputs-after.sha256" "${digest}  ${path}\n")
endforeach()
equal("${after}" "${before}" "All 582 original MAT files unchanged")
get_property(count GLOBAL PROPERTY DICTIONARY_CALLS)
message(STATUS "Dictionary real process calls=${count}; evidence=${root}/evidence")
