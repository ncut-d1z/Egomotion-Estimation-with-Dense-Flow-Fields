# 由实际CLI测试调用。CMake独立解析JSON；不将导出器替身当实际SVG证据。
function(artifact_field json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    equal("${error}" NOTFOUND "Artifact JSON field ${ARGN}")
    equal("${actual}" "${expected}" "Artifact JSON field ${ARGN}")
endfunction()
function(check_artifact_execution root id source_blob)
    file(READ "${root}/output/${id}/invocation.json" invocation)
    file(READ "${root}/output/${id}/execution.json" execution)
    artifact_field("${invocation}" egomotion-invocation-v1 schema)
    artifact_field("${execution}" egomotion-execution-v1 schema)
    artifact_field("${invocation}" "${id}" run_id)
    artifact_field("${execution}" "${id}" run_id)
    artifact_field("${invocation}" "${SOURCE_SHA}" repo_sha)
    artifact_field("${invocation}" "${source_blob}" source_blob_sha)
    artifact_field("${invocation}" "${root}" working_directory)
    artifact_field("${invocation}" "${root}/output/${id}" output_directory)
    artifact_field("${invocation}" started phase)
    artifact_field("${invocation}" artifact_export record_scope)
    artifact_field("${invocation}" ON arguments_exclude_argv0)
    artifact_field("${invocation}" not_used algorithm_rng seed_origin)
    foreach(key IN ITEMS seed engine)
        string(JSON type TYPE "${invocation}" algorithm_rng ${key})
        equal("${type}" NULL "No algorithm RNG for artifact")
    endforeach()
    foreach(record IN ITEMS invocation execution)
        string(JSON type TYPE "${${record}}" calculation_manifest)
        equal("${type}" NULL "No fictional calculation manifest")
    endforeach()
    if(EXISTS "${root}/output/${id}/manifest.json")
        message(SEND_ERROR "Artifact unexpectedly wrote calculation manifest")
    endif()
    artifact_field("${invocation}" Linux environment kernel system)
    artifact_field("${invocation}" 17 environment build cpp_standard)
    artifact_field("${invocation}" "${SVG_ENABLED}" environment build svg_enabled)
    string(JSON count LENGTH "${invocation}" arguments)
    list(LENGTH ARGN expected_count)
    equal("${count}" "${expected_count}" "Artifact exact argv length")
    set(index 0)
    foreach(argument IN LISTS ARGN)
        artifact_field("${invocation}" "${argument}" arguments ${index})
        math(EXPR index "${index}+1")
    endforeach()
    list(GET ARGN 0 command)
    artifact_field("${invocation}" "${command}" command)
    artifact_field("${execution}" ON invocation_confirmed)
    artifact_field("${execution}" 0 exit_code_if_record_published)
    artifact_field("${execution}" 6 exit_code_on_record_failure)
    string(JSON count LENGTH "${execution}" channel_attempts)
    equal("${count}" 1 "One artifact response")
    artifact_field("${execution}" stdout channel_attempts 0 channel)
    artifact_field("${execution}" ON channel_attempts 0 write_and_flush_succeeded)
    artifact_field("${execution}" "${output}" channel_attempts 0 attempted_text)
    string(JSON start GET "${invocation}" started_utc)
    string(JSON finish GET "${execution}" finished_utc)
    foreach(value IN ITEMS "${start}" "${finish}")
        if(NOT value MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$")
            message(SEND_ERROR "Invalid artifact timestamp ${value}")
        endif()
    endforeach()
    if(finish STRLESS start)
        message(SEND_ERROR "Artifact end precedes start")
    endif()
    set(recorded_artifact_invocation "${invocation}" PARENT_SCOPE)
endfunction()
function(check_artifact_inputs invocation dataset)
    artifact_field("${invocation}" analyzed_mat_snapshots inputs kind)
    string(JSON count LENGTH "${dataset}" curves)
    string(JSON recorded_count LENGTH "${invocation}" inputs curves)
    equal("${recorded_count}" "${count}" "All analysis curves retain identities")
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON curve GET "${dataset}" curves ${index})
        string(JSON name GET "${curve}" id)
        artifact_field("${invocation}" "${name}" inputs curves ${index} id)
        string(JSON helpers GET "${curve}" helper_source_blob_shas)
        artifact_field("${invocation}" "${helpers}" inputs curves ${index} helper_source_blob_shas)
        string(JSON inputs GET "${curve}" inputs)
        artifact_field("${invocation}" "${inputs}" inputs curves ${index} mat_files)
    endforeach()
endfunction()
