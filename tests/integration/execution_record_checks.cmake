# 由真实CLI进程测试调用；用CMake独立JSON解析器检查记录，不靠字符串存在判断。
function(check_execution root id expected_exit)
    file(READ "${root}/output/${id}/invocation.json" invocation)
    file(READ "${root}/output/${id}/execution.json" execution)
    file(READ "${root}/output/${id}/manifest.json" manifest)
    field("${invocation}" egomotion-invocation-v1 schema)
    field("${execution}" egomotion-execution-v1 schema)
    field("${invocation}" "${id}" run_id)
    field("${execution}" "${id}" run_id)
    field("${invocation}" "${SOURCE_SHA}" repo_sha)
    field("${invocation}" "${root}" working_directory)
    field("${invocation}" "${root}/output/${id}" output_directory)
    field("${invocation}" started phase)
    field("${invocation}" ON arguments_exclude_argv0)
    field("${invocation}" generated_from_source_and_rng inputs kind)
    string(JSON input_count LENGTH "${invocation}" inputs mat_files)
    equal("${input_count}" 0 "Generated experiment does not claim historical MAT inputs")
    field("${invocation}" Linux environment kernel system)
    field("${invocation}" 17 environment build cpp_standard)
    field("${invocation}" 53 environment build double_digits)
    string(JSON seed GET "${manifest}" algorithm_rng_seed)
    string(JSON blob GET "${manifest}" source_blob_sha)
    field("${invocation}" "${seed}" algorithm_rng seed)
    field("${invocation}" "${blob}" source_blob_sha)
    field("${execution}" ON invocation_confirmed)
    field("${execution}" "${expected_exit}" exit_code_if_record_published)
    field("${execution}" 6 exit_code_on_record_failure)
    foreach(key IN ITEMS started_utc)
        string(JSON time GET "${invocation}" ${key})
        if(NOT time MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$")
            message(SEND_ERROR "Invalid actual timestamp ${time}")
        endif()
    endforeach()
    string(JSON end_time GET "${execution}" finished_utc)
    if(NOT end_time MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$")
        message(SEND_ERROR "Invalid actual completion timestamp ${end_time}")
    endif()
    if(end_time STRLESS time)
        message(SEND_ERROR "Execution ends before start")
    endif()
    string(JSON count LENGTH "${invocation}" arguments)
    list(LENGTH ARGN expected_count)
    equal("${count}" "${expected_count}" "Exact argument count")
    set(index 0)
    foreach(argument IN LISTS ARGN)
        field("${invocation}" "${argument}" arguments ${index})
        math(EXPR index "${index}+1")
    endforeach()
    string(JSON channel_count LENGTH "${execution}" channel_attempts)
    equal("${channel_count}" 1 "One complete success/failure notification")
    field("${execution}" ON channel_attempts 0 write_and_flush_succeeded)
    string(JSON attempted GET "${execution}" channel_attempts 0 attempted_text)
    if(expected_exit EQUAL 0)
        field("${execution}" stdout channel_attempts 0 channel)
        field("${attempted}" "${id}" run_id)
        field("${attempted}" Complete status)
    else()
        field("${execution}" stderr channel_attempts 0 channel)
        field("${attempted}" "${id}" run_id)
        field("${attempted}" "${expected_exit}" exit_code)
    endif()
    set(recorded_invocation "${invocation}" PARENT_SCOPE)
    set(recorded_execution "${execution}" PARENT_SCOPE)
endfunction()
