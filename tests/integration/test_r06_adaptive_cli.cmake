cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/execution_record_checks.cmake")
# 三入口的真实进程/装配/发布回归；保留源配置，未用Step替身、未做L4统计。
foreach(required IN ITEMS CLI VALUE_PROBE INIT_TRACE SOURCE_ROOT SOURCE_SHA SANDBOX)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(root "${SANDBOX}/Adaptive 中文 空格/${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse evidence")
endif()
file(MAKE_DIRECTORY "${root}/origin" "${root}/evidence")
set(archive "${SOURCE_ROOT}/origin/egomotion_estimation_dense_flow_fields_matlab_scripts/adaptive_matched_filter_test/produced_data/initialization")
set_property(GLOBAL PROPERTY ADAPTIVE_CLI_CALLS 0)
function(equal actual expected why)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${why}: expected [${expected}], got [${actual}]")
    endif()
endfunction()
function(field json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    equal("${error}" NOTFOUND "JSON field ${ARGN}")
    equal("${actual}" "${expected}" "JSON field ${ARGN}")
endfunction()
function(invoke executable label expected)
    get_property(count GLOBAL PROPERTY ADAPTIVE_CLI_CALLS)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY ADAPTIVE_CLI_CALLS ${count})
    set(log "${root}/evidence/${count}-${label}")
    string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${log}.meta" "source_sha=${SOURCE_SHA}\ncwd=${root}\nstart=${start}\nexecutable=${executable}\nseed=actual algorithm_rng_seed retained in each manifest\n")
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.meta" "argv=${arg}\n")
    endforeach()
    execute_process(COMMAND "${executable}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 120)
    string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${log}.meta" "end=${end}\nexit=${status}\nexpected_exit=${expected}\n")
    file(WRITE "${log}.stdout" "${stdout}")
    file(WRITE "${log}.stderr" "${stderr}")
    equal("${status}" "${expected}" "${label}, evidence ${log}")
    if(status EQUAL 0)
        equal("${stderr}" "" "Success stderr")
    else()
        equal("${stdout}" "" "Failure stdout")
    endif()
    set(output "${stdout}" PARENT_SCOPE)
    set(diagnostic "${stderr}" PARENT_SCOPE)
    set(exit_code "${status}" PARENT_SCOPE)
    message(STATUS "${label} exit=${status}; evidence=${log}")
endfunction()
function(common_manifest id kind blob repetitions)
    if(NOT EXISTS "${root}/output/${id}/manifest.json")
        message(SEND_ERROR "Missing actual ${kind} manifest")
        return()
    endif()
    file(READ "${root}/output/${id}/manifest.json" manifest)
    field("${manifest}" egomotion-run-manifest-v2 schema)
    field("${manifest}" "${SOURCE_SHA}" repo_sha)
    field("${manifest}" "${blob}" source_blob_sha)
    field("${manifest}" "${id}" run_id)
    field("${manifest}" "${kind}" experiment_kind)
    field("${manifest}" "${repetitions}" expected_repetitions)
    string(JSON seed GET "${manifest}" algorithm_rng_seed)
    if(NOT seed MATCHES "^[0-9]+$" OR seed GREATER 4294967295)
        message(SEND_ERROR "Missing actual UINT32 algorithm seed")
    endif()
    set(manifest "${manifest}" PARENT_SCOPE)
endfunction()
function(duplicate id command)
    file(SHA256 "${root}/output/${id}/manifest.json" before)
    invoke("${CLI}" "duplicate-${id}" 6 "${command}" ${ARGN} --run-id "${id}")
    field("${diagnostic}" MatErrorCode error_domain)
    field("${diagnostic}" OutputExists error_code)
    file(SHA256 "${root}/output/${id}/manifest.json" after)
    equal("${after}" "${before}" "Existing run evidence untouched")
endfunction()
function(check_delivery id kind repetitions frames run_output)
    field("${manifest}" "${repetitions}" attempted)
    field("${manifest}" "${repetitions}" completed)
    field("${manifest}" 0 failed)
    field("${manifest}" ON computation_complete)
    field("${manifest}" "${repetitions}" aggregation_denominator)
    field("${manifest}" "${frames}" metric_validity frame_count)
    field("${manifest}" "${repetitions}" metric_validity planned_runs)
    field("${manifest}" "${repetitions}" metric_validity completed_runs)
    string(JSON valid GET "${manifest}" valid)
    string(JSON missing GET "${manifest}" undefined)
    math(EXPR total "(${frames}-2)*${repetitions}")
    math(EXPR recorded "${valid}+${missing}")
    equal("${recorded}" "${total}" "All original interior frame/repetition indices remain counted")
    field("${manifest}" "${valid}" metric_validity valid_frames)
    field("${manifest}" "${missing}" metric_validity undefined_frames)
    if(missing GREATER 0)
        set(status Incomplete)
        field("${manifest}" OFF statistics_complete)
    else()
        set(status Complete)
        field("${manifest}" ON statistics_complete)
    endif()
    field("${manifest}" "${status}" completeness)
    field("${run_output}" "${status}" status)
    field("${run_output}" "${id}" run_id)
    field("${run_output}" "${repetitions}" completed)
    field("${run_output}" "${valid}" valid)
    field("${run_output}" "${missing}" undefined)
    field("${run_output}" 0 failed)
    string(JSON count LENGTH "${manifest}" errors)
    equal("${count}" 0 "Missing metrics are separate from actual solver/output failures")
    string(JSON count LENGTH "${manifest}" metric_validity repetitions)
    equal("${count}" "${repetitions}" "All original per-run values are retained")
    if(kind STREQUAL adaptive-update-rates)
        set(sources allemittransfehler allemitrotfehler akrot)
    else()
        set(sources allemittransfehler allemitrotfehler alleohnetransfehler alleohnerotfehler)
        if(kind STREQUAL adaptive-comparison)
            list(APPEND sources rottransratio)
        endif()
    endif()
    set(names egomotion_metric_policy)
    foreach(source IN LISTS sources)
        list(APPEND names "valid_${source}" "${source}")
    endforeach()
    list(LENGTH names expected)
    string(JSON count LENGTH "${manifest}" mat_files)
    equal("${count}" "${expected}" "Source fields, same-shape validity companions and one policy marker")
    file(GLOB files RELATIVE "${root}/output/${id}" "${root}/output/${id}/*")
    list(LENGTH files count)
    math(EXPR expected_files "${expected}+3")
    equal("${count}" "${expected_files}" "Only MAT results, Manifest and two execution records")
    math(EXPR last "${expected}-1")
    foreach(index RANGE 0 ${last})
        list(GET names ${index} name)
        field("${manifest}" "${name}" mat_files ${index} variable)
        field("${manifest}" "${name}.mat" mat_files ${index} file)
        file(SHA256 "${root}/output/${id}/${name}.mat" hash)
        file(SIZE "${root}/output/${id}/${name}.mat" bytes)
        field("${manifest}" "${hash}" mat_files ${index} sha256)
        field("${manifest}" "${bytes}" mat_files ${index} bytes)
        if(name STREQUAL egomotion_metric_policy)
            set(shape 1x4)
        elseif(kind STREQUAL adaptive-update-rates AND NOT name MATCHES "^(valid_)?akrot$")
            set(shape "${frames}x4")
        else()
            set(shape "${frames}x1")
        endif()
        invoke("${CLI}" "inspect-${id}-${name}" 0 inspect-mat --file "${root}/output/${id}/${name}.mat" --variable "${name}")
        if(NOT output MATCHES "variable=${name} class=6 type=[0-9]+ rank=2 dims=${shape} ")
            message(SEND_ERROR "Generated MAT metadata mismatch: ${output}")
        endif()
    endforeach()
endfunction()
function(source_run id command kind blob repetitions frames)
    # 本合同要求新指标语义下走完全部求解。若出现真正的数值失败，保留日志并让测试失败；
    # 不把历史 frame14/frame151 的失败固化成成功条件，也不宣称本次已运行通过。
    invoke("${CLI}" "${id}" 0 "${command}" ${ARGN} --run-id "${id}")
    common_manifest("${id}" "${kind}" "${blob}" "${repetitions}")
    check_execution("${root}" "${id}" "${exit_code}" "${command}" ${ARGN} --run-id "${id}")
    field("${recorded_invocation}" os_random algorithm_rng seed_origin)
    if(command STREQUAL run-adaptive-comparison)
        field("${recorded_invocation}" 0 effective_config noise_scale)
    endif()
    if(NOT exit_code EQUAL 0)
        return()
    endif()
    check_delivery("${id}" "${kind}" "${repetitions}" "${frames}" "${output}")
    if(kind STREQUAL adaptive-init)
        invoke("${INIT_TRACE}" real-initialization-trace 0 "${root}/evidence/initialization-frame14.csv")
        invoke("${VALUE_PROBE}" independent-values 0 "${root}/output/${id}" "${archive}" "${root}/evidence/initialization-values.csv")
        invoke("${CLI}" analyze-initialization 0 analyze --experiment adaptive-init --input-root "${root}/output/${id}")
        field("${output}" egomotion-analysis-v2 schema)
        string(JSON count LENGTH "${output}" curves)
        equal("${count}" 2 "Initialization analyzer preserves two selected curves")
    endif()
    duplicate("${id}" "${command}" ${ARGN})
endfunction()
