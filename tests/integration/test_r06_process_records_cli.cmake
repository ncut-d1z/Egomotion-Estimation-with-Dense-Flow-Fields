function(equal actual expected reason)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${reason}: actual=${actual}, expected=${expected}")
    endif()
endfunction()
function(field json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    equal("${error}" NOTFOUND "JSON field ${ARGN}")
    equal("${actual}" "${expected}" "JSON field ${ARGN}")
endfunction()
set(cases 0)
function(context_check directory expected accepted)
    file(READ "${directory}/start.json" start)
    file(READ "${directory}/finish.json" finish)
    string(JSON id GET "${start}" record_id)
    field("${start}" context.jsonl application_context file)
    field("${start}" egomotion-context-event-v1 application_context schema)
    field("${finish}" ON context_return_confirmed)
    file(SHA256 "${directory}/context.jsonl" digest)
    file(SIZE "${directory}/context.jsonl" bytes)
    field("${finish}" "${digest}" channels 2 sha256)
    field("${finish}" "${bytes}" channels 2 bytes)
    field("${finish}" ON channels 2 fsync_succeeded)
    file(STRINGS "${directory}/context.jsonl" events ENCODING UTF-8)
    set(names "")
    set(sequence 0)
    foreach(event IN LISTS events)
        math(EXPR sequence "${sequence}+1")
        field("${event}" "${sequence}" sequence)
        field("${event}" "${id}" record_id)
        field("${event}" egomotion-context-event-v1 schema)
        string(JSON timestamp GET "${event}" observed_utc)
        if(NOT timestamp MATCHES "^[0-9]+-[0-9]+-[0-9]+T[0-9]+:[0-9]+:[0-9]+Z$")
            message(FATAL_ERROR "Missing actual UTC observation time")
        endif()
        string(JSON name GET "${event}" event)
        string(JSON data GET "${event}" data)
        list(APPEND names "${name}")
        set(observed_${name} "${data}" PARENT_SCOPE)
        if(name STREQUAL mat_snapshot_prepared)
            string(JSON path GET "${data}" path)
            file(SHA256 "${path}" independent)
            field("${data}" "${independent}" mat_sha256)
        elseif(name STREQUAL application_returned)
            field("${data}" "${expected}" application_exit_code)
        elseif(name STREQUAL run_id_reserved)
            string(JSON output_dir GET "${data}" output_directory)
            string(JSON run_id GET "${data}" run_id)
            if(NOT IS_DIRECTORY "${output_dir}")
                message(FATAL_ERROR "Reserved directory is missing")
            endif()
            if(run_id STREQUAL id)
                message(FATAL_ERROR "RecordId must remain independent of RunId")
            endif()
        elseif(name STREQUAL run_context OR name STREQUAL artifact_context)
            string(JSON output_dir GET "${data}" output_directory)
            file(READ "${output_dir}/invocation.json" invocation)
            string(JSON normalized GET "${invocation}")
            equal("${data}" "${normalized}" "Exact actual invocation linked to process context")
            field("${data}" "${SOURCE_SHA}" repo_sha)
        endif()
    endforeach()
    list(GET names 0 first)
    list(GET names -1 last)
    equal("${first}" application_entering "Entry recorded before application")
    equal("${last}" application_returned "Actual application return recorded last")
    if(accepted)
        list(GET names 1 command)
        equal("${command}" command_accepted "Parsed command recorded")
    else()
        equal("${names}" "application_entering;application_returned" "Parse failure never becomes accepted command")
    endif()
    set(observed_names "${names}" PARENT_SCOPE)
endfunction()
function(check label expected)
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE bare_exit OUTPUT_FILE "${root}/evidence/${label}.stdout"
        ERROR_FILE "${root}/evidence/${label}.stderr" TIMEOUT 25)
    equal("${bare_exit}" "${expected}" "Original command ${label}")
    execute_process(COMMAND "${RECORDER}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE recorded_exit OUTPUT_VARIABLE receipt ERROR_VARIABLE errors TIMEOUT 25)
    file(WRITE "${root}/evidence/${label}.receipt.json" "${receipt}")
    file(WRITE "${root}/evidence/${label}.recorder-stderr" "${errors}")
    equal("${recorded_exit}" "${bare_exit}" "Same application exit ${label}")
    equal("${errors}" "" "No supervisor failure ${label}")
    string(JSON directory GET "${receipt}" record_directory)
    string(JSON id GET "${receipt}" record_id)
    equal("${directory}" "${root}/build-cli-records/${id}" "Fixed audit log location")
    string(LENGTH "${id}" id_size)
    equal("${id_size}" 39 "128-bit record identity plus prefix")
    if(NOT id MATCHES "^record_[0-9a-f]+$")
        message(FATAL_ERROR "Invalid independent record identity")
    endif()
    file(READ "${directory}/start.json" start)
    file(READ "${directory}/finish.json" finish)
    field("${start}" egomotion-process-start-v2 schema)
    field("${finish}" egomotion-process-finish-v2 schema)
    field("${start}" "${SOURCE_SHA}" repo_sha)
    field("${start}" "${root}" working_directory)
    field("${start}" "${id}" record_id)
    field("${finish}" "${id}" record_id)
    field("${start}" fork_same_build_application execution_mode)
    field("${start}" Linux environment kernel system)
    field("${start}" 17 environment build cpp_standard)
    field("${finish}" exited termination)
    field("${finish}" "${expected}" child_exit_code)
    field("${finish}" ON channels_confirmed)
    field("${finish}" "${expected}" exit_code_if_record_and_receipt_confirmed)
    field("${finish}" 6 exit_code_on_record_or_receipt_failure)
    string(JSON signal_type TYPE "${finish}" signal)
    equal("${signal_type}" NULL "Normal exit is not signal termination")
    string(JSON count LENGTH "${start}" arguments)
    list(LENGTH ARGN expected_count)
    equal("${count}" "${expected_count}" "Exact argument count")
    set(index 0)
    foreach(argument IN LISTS ARGN)
        field("${start}" "${argument}" arguments ${index})
        math(EXPR index "${index}+1")
    endforeach()
    if(expected EQUAL 2)
        context_check("${directory}" "${expected}" OFF)
    else()
        context_check("${directory}" "${expected}" ON)
    endif()
    if(label STREQUAL inspect)
        field("${observed_mat_snapshot_prepared}" metadata purpose)
        equal("${observed_names}" "application_entering;command_accepted;mat_snapshot_prepared;application_returned" "Inspect records one metadata snapshot")
    elseif(label STREQUAL reservation)
        field("${observed_seed_selected}" 7 seed)
        field("${observed_seed_selected}" config origin)
        equal("${observed_names}" "application_entering;command_accepted;seed_selected;application_returned" "Collision never fabricates reserved RunId")
    elseif(label STREQUAL analysis)
        if(NOT "analysis_ready" IN_LIST observed_names)
            message(FATAL_ERROR "Successful analysis missing source identity")
        endif()
        file(READ "${directory}/stdout.bin" dataset)
        string(JSON source GET "${dataset}" source_analysis_blob)
        field("${observed_analysis_ready}" "${source}" source_blob_sha)
    endif()
    set(index 0)
    foreach(channel IN ITEMS stdout stderr)
        file(SHA256 "${root}/evidence/${label}.${channel}" expected_hash)
        file(SHA256 "${directory}/${channel}.bin" actual_hash)
        equal("${actual_hash}" "${expected_hash}" "Raw channel bytes match original ${label}/${channel}")
        file(SIZE "${directory}/${channel}.bin" bytes)
        field("${finish}" "${actual_hash}" channels ${index} sha256)
        field("${finish}" "${bytes}" channels ${index} bytes)
        field("${finish}" ON channels ${index} fsync_succeeded)
        math(EXPR index "${index}+1")
    endforeach()
    math(EXPR cases "${cases}+1")
    set(cases "${cases}" PARENT_SCOPE)
endfunction()
