set(generated 0)
function(generate label expected)
    execute_process(COMMAND "${RECORDER}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE code OUTPUT_VARIABLE receipt ERROR_VARIABLE errors TIMEOUT 45)
    file(WRITE "${root}/evidence/${label}.receipt.json" "${receipt}")
    file(WRITE "${root}/evidence/${label}.recorder-stderr" "${errors}")
    equal("${code}" "${expected}" "Recorded generation exit")
    equal("${errors}" "" "No process record failure")
    string(JSON directory GET "${receipt}" record_directory)
    context_check("${directory}" "${expected}" ON)
    if(label MATCHES "^bias")
        field("${observed_seed_selected}" 7 seed)
        field("${observed_run_context}" 7 algorithm_rng seed)
        field("${observed_command_accepted}" 2 effective_config maximum_subdivision_level)
        string(JSON id GET "${observed_run_id_reserved}" run_id)
        field("${observed_run_context}" "${id}" run_id)
        file(READ "${root}/output/${id}/manifest.json" manifest)
        field("${manifest}" Complete completeness)
    elseif(label STREQUAL adaptive-init)
        string(JSON seed GET "${observed_seed_selected}" seed)
        field("${observed_seed_selected}" os_random origin)
        field("${observed_run_context}" "${seed}" algorithm_rng seed)
        string(JSON id GET "${observed_run_id_reserved}" run_id)
        field("${observed_run_context}" "${id}" run_id)
        file(READ "${root}/output/${id}/manifest.json" manifest)
        field("${manifest}" egomotion-run-manifest-v2 schema)
        field("${manifest}" 1 completed)
        field("${manifest}" 0 failed)
        field("${manifest}" ON computation_complete)
        string(JSON valid GET "${manifest}" valid)
        string(JSON missing GET "${manifest}" undefined)
        math(EXPR frames "${valid}+${missing}")
        equal("${frames}" 33 "All original Adaptive initialization frames remain in the ledger")
        if(missing GREATER 0)
            set(completeness Incomplete)
            field("${manifest}" OFF statistics_complete)
        else()
            set(completeness Complete)
            field("${manifest}" ON statistics_complete)
        endif()
        field("${manifest}" "${completeness}" completeness)
        file(READ "${directory}/stdout.bin" response)
        field("${response}" "${id}" run_id)
        field("${response}" "${completeness}" status)
        field("${response}" 1 completed)
        field("${response}" "${missing}" undefined)
        file(SIZE "${directory}/stderr.bin" error_bytes)
        equal("${error_bytes}" 0 "Delivered partial metrics do not produce a solver-failure diagnostic")
        file(GLOB mats "${root}/output/${id}/*.mat")
        list(LENGTH mats count)
        equal("${count}" 9 "Four source fields, four validity companions and the metric policy")
        if(NOT EXISTS "${root}/output/${id}/egomotion_metric_policy.mat")
            message(FATAL_ERROR "Adaptive process omitted the mandatory metric policy marker")
        endif()
    elseif(SVG_ENABLED)
        string(JSON id GET "${observed_run_id_reserved}" run_id)
        field("${observed_artifact_context}" "${id}" run_id)
        field("${observed_artifact_context}" not_used algorithm_rng seed_origin)
    elseif("run_id_reserved" IN_LIST observed_names)
        message(FATAL_ERROR "Unavailable exporter must not reserve RunId")
    endif()
    math(EXPR generated "${generated}+1")
    set(generated "${generated}" PARENT_SCOPE)
endfunction()
