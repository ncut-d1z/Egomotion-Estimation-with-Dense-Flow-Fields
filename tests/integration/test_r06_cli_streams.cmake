cmake_minimum_required(VERSION 3.28)
# Linux /dev/full 提供真实ENOSPC；只写新测试沙箱，不执行完整科学实验。
foreach(required IN ITEMS CLI SANDBOX SOURCE_SHA SVG_ENABLED)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(NOT EXISTS /dev/full)
    message(FATAL_ERROR "Linux output-failure test requires /dev/full")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(root "${SANDBOX}/输出流 中文/${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse evidence")
endif()
file(MAKE_DIRECTORY "${root}/origin" "${root}/evidence")
function(equal actual expected reason)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${reason}: expected [${expected}], got [${actual}]")
    endif()
endfunction()
function(field json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    equal("${error}" NOTFOUND "JSON ${ARGN}")
    equal("${actual}" "${expected}" "JSON ${ARGN}")
endfunction()
set_property(GLOBAL PROPERTY STREAM_CALLS 0)
function(invoke label channel)
    get_property(count GLOBAL PROPERTY STREAM_CALLS)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY STREAM_CALLS ${count})
    set(log "${root}/evidence/${count}-${label}")
    string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${log}.meta" "source_sha=${SOURCE_SHA}\ncwd=${root}\nstart=${start}\nexecutable=${CLI}\n${channel}=/dev/full\nseed=7 for bounded Bias; none for other inputs\n")
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.meta" "argv=${arg}\n")
    endforeach()
    if(channel STREQUAL stdout)
        execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${root}"
            RESULT_VARIABLE status OUTPUT_FILE /dev/full ERROR_VARIABLE diagnostic TIMEOUT 45)
        file(WRITE "${log}.stderr" "${diagnostic}")
        field("${diagnostic}" ExperimentErrorCode error_domain)
        field("${diagnostic}" OutputFailed error_code)
        field("${diagnostic}" output stage)
        field("${diagnostic}" 6 exit_code)
        set(error "${diagnostic}" PARENT_SCOPE)
    else()
        execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${root}"
            RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_FILE /dev/full TIMEOUT 45)
        file(WRITE "${log}.stdout" "${output}")
        equal("${output}" "" "Diagnostic delivery failure cannot use stdout")
    endif()
    string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${log}.meta" "end=${end}\nexit=${status}\nexpected_exit=6\n")
    equal("${status}" 6 "${label}: output failure exit; ${log}")
endfunction()
invoke(help stdout help)
invoke(version stdout version)
invoke(illustration-json stdout illustrate --kind circle)
invoke(parse stderr unknown-command)
invoke(read stderr inspect-mat --file missing.mat)
invoke(numerical stderr illustrate --kind harmonic --degree 200 --order 200)
invoke(bias stdout run-bias-occluded --seed 7 --level 2 --run-id committed)
field("${error}" committed run_id)
set(fixture "${root}/output/committed")
file(READ "${fixture}/manifest.json" manifest)
field("${manifest}" Complete completeness)
field("${manifest}" "${SOURCE_SHA}" repo_sha)
field("${manifest}" 0 failed)
string(JSON count LENGTH "${manifest}" mat_files)
equal("${count}" 7 "Seven published MAT outputs")
file(GLOB files LIST_DIRECTORIES false "${fixture}/*")
list(LENGTH files count)
equal("${count}" 8 "All data and durable Manifest retained despite stdout failure")
foreach(path IN LISTS files)
    file(SHA256 "${path}" digest)
    list(APPEND before "${digest}")
    file(APPEND "${root}/evidence/inputs-before.sha256" "${digest}  ${path}\n")
endforeach()
invoke(inspect stdout inspect-mat --file "${fixture}/xwerte.mat")
invoke(analyze stdout analyze --experiment bias --input-root "${fixture}")
if(SVG_ENABLED)
    invoke(plot stdout plot --experiment bias --input-root "${fixture}" --run-id plot)
    field("${error}" plot run_id)
    file(GLOB svg_files "${root}/output/plot/*.svg")
    list(LENGTH svg_files count)
    equal("${count}" 1 "Published Bias SVG retained")
    invoke(illustration-svg stdout illustrate --kind circle --format svg --run-id illustration)
    field("${error}" illustration run_id)
    foreach(name IN ITEMS illustration.json illustration.svg)
        if(NOT EXISTS "${root}/output/illustration/${name}")
            message(SEND_ERROR "Missing retained ${name}")
        endif()
    endforeach()
else()
    invoke(plot-unavailable stderr plot --experiment bias --input-root "${fixture}" --run-id plot)
    invoke(illustration-unavailable stderr illustrate --kind circle --format svg --run-id illustration)
    if(EXISTS "${root}/output/plot" OR EXISTS "${root}/output/illustration")
        message(SEND_ERROR "Missing backend must not reserve output")
    endif()
endif()
foreach(path IN LISTS files)
    file(SHA256 "${path}" digest)
    list(APPEND after "${digest}")
    file(APPEND "${root}/evidence/inputs-after.sha256" "${digest}  ${path}\n")
endforeach()
equal("${after}" "${before}" "Existing verified outputs preserved")
file(GLOB originals "${root}/origin/*")
equal("${originals}" "" "Original marker untouched")
get_property(count GLOBAL PROPERTY STREAM_CALLS)
message(STATUS "CLI output failure process calls=${count}; evidence=${root}/evidence")
