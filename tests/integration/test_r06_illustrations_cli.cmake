cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/artifact_record_checks.cmake")
# 固定几何插图的真实CLI回归；无MAT、RNG算法样本或完整科学实验。
foreach(required IN ITEMS CLI SANDBOX SOURCE_SHA SVG_ENABLED)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(DEFINED ENV{DISPLAY} OR DEFINED ENV{WAYLAND_DISPLAY})
    message(FATAL_ERROR "CTest must unset display service variables")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(root "${SANDBOX}/插图 中文 空格/${suffix}")
if(EXISTS "${root}")
    message(FATAL_ERROR "Refuse to reuse test evidence")
endif()
file(MAKE_DIRECTORY "${root}/origin" "${root}/evidence")
file(WRITE "${root}/evidence/build-mode.txt" "SVG_ENABLED=${SVG_ENABLED}\nDISPLAY=unset\nWAYLAND_DISPLAY=unset\n")
set_property(GLOBAL PROPERTY ILLUSTRATION_CALLS 0)
function(equal actual expected reason)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(SEND_ERROR "${reason}: expected [${expected}], got [${actual}]")
    endif()
endfunction()
function(field json expected)
    string(JSON actual ERROR_VARIABLE error GET "${json}" ${ARGN})
    equal("${error}" NOTFOUND "JSON field ${ARGN}")
    equal("${actual}" "${expected}" "JSON field ${ARGN}")
endfunction()
function(invoke label expected)
    get_property(count GLOBAL PROPERTY ILLUSTRATION_CALLS)
    math(EXPR count "${count}+1")
    set_property(GLOBAL PROPERTY ILLUSTRATION_CALLS ${count})
    set(log "${root}/evidence/${count}-${label}")
    string(TIMESTAMP start "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${log}.meta" "source_sha=${SOURCE_SHA}\ncwd=${root}\nstart=${start}\nexecutable=${CLI}\nseed=none (fixed geometric data)\n")
    foreach(arg IN LISTS ARGN)
        file(APPEND "${log}.meta" "argv=${arg}\n")
    endforeach()
    execute_process(COMMAND "${CLI}" ${ARGN} WORKING_DIRECTORY "${root}"
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    string(TIMESTAMP end "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(APPEND "${log}.meta" "end=${end}\nexit=${status}\nexpected_exit=${expected}\n")
    file(WRITE "${log}.stdout" "${stdout}")
    file(WRITE "${log}.stderr" "${stderr}")
    equal("${status}" "${expected}" "${label}: ${log}")
    if(expected EQUAL 0)
        equal("${stderr}" "" "Success stderr")
    else()
        equal("${stdout}" "" "Failure stdout")
        field("${stderr}" "${expected}" exit_code)
    endif()
    set(output "${stdout}" PARENT_SCOPE)
    set(diagnostic "${stderr}" PARENT_SCOPE)
endfunction()
function(reject label)
    invoke("${label}" 2 illustrate ${ARGN})
    field("${diagnostic}" ExperimentErrorCode error_domain)
    field("${diagnostic}" InvalidParameters error_code)
    field("${diagnostic}" parse stage)
endfunction()
function(reject_svg label)
    invoke("${label}" 7 illustrate ${ARGN} --format svg)
    field("${diagnostic}" Bootstrap error_domain)
    field("${diagnostic}" BackendUnavailable error_code)
    field("${diagnostic}" plot stage)
    if(EXISTS "${root}/output")
        message(SEND_ERROR "Missing SVG backend must not reserve output")
    endif()
endfunction()
invoke(help 0 illustrate --help)
if(NOT output MATCHES "illustrate --kind")
    message(SEND_ERROR "Missing illustration help")
endif()
reject(no-kind)
reject(unknown-kind --kind unknown)
reject(unknown-format --kind circle --format png)
reject(missing-value --kind)
reject(duplicate --kind circle --kind sinusoidal)
reject(custom-output --kind circle --output-root elsewhere)
reject(json-run-id --kind circle --run-id invalid-here)
reject(trajectory-degree --kind circle --degree 1)
reject(trajectory-order --kind sinusoidal --order 1)
reject(missing-degree --kind harmonic --order 1)
reject(missing-order --kind harmonic --degree 1)
reject(negative --kind harmonic --degree -1 --order 0)
reject(negative-order --kind harmonic --degree 3 --order -2)
reject(order-range --kind harmonic --degree 0 --order 1)
reject(noninteger --kind harmonic --degree 1.5 --order 0)
reject(degree-overflow --kind harmonic --degree 2147483648 --order 0)
reject(unsafe-run-id --kind circle --format svg --run-id ../origin)
invoke(overflow 5 illustrate --kind harmonic --degree 200 --order 200 --format svg --run-id overflow)
field("${diagnostic}" NumericalErrorCode error_domain)
field("${diagnostic}" NonFiniteResult error_code)
if(EXISTS "${root}/output")
    message(SEND_ERROR "Parse/numerical failure unexpectedly created output")
endif()

foreach(kind IN ITEMS circle sinusoidal harmonic)
    set(extra)
    if(kind STREQUAL harmonic)
        set(extra --degree 3 --order 2)
        set(grid 41)
        set(blob d7f97e0fe15c761f33f6ebd152610ec4144561e9)
        set(points 0)
        set(faces 3200)
    else()
        set(grid 51)
        set(points 600)
        set(faces 2208)
        if(kind STREQUAL circle)
            set(blob c6bdbff07cdfff796c105f299fb728b15783ac7c)
        else()
            set(blob 06022612e9249c532f4dabae5658efa9ece4c10d)
        endif()
    endif()
    invoke("numeric-${kind}" 0 illustrate --kind "${kind}" ${extra})
    set(numeric "${output}")
    if(NOT kind STREQUAL harmonic)
        string(JSON archive_geometry REMOVE "${numeric}" view)
        string(SHA256 "archive_${kind}" "${archive_geometry}")
        field("${numeric}" -37.5 view azimuth_degrees)
        field("${numeric}" 30 view elevation_degrees)
    endif()
    field("${numeric}" egomotion-illustration-v1 schema)
    field("${numeric}" "${kind}" kind)
    field("${numeric}" "${blob}" source_script_blob)
    field("${numeric}" "${grid}" surface rows)
    field("${numeric}" "${grid}" surface columns)
    field("${numeric}" column-major surface layout)
    string(JSON count LENGTH "${numeric}" trajectory_xyz)
    equal("${count}" "${points}" "Trajectory count")
    math(EXPR grid_count "${grid}*${grid}")
    string(JSON count LENGTH "${numeric}" surface vertices_xyz)
    equal("${count}" "${grid_count}" "Mesh count")
    if(NOT kind STREQUAL harmonic)
        field("${numeric}" "circular trajectory within the sphere" source_title)
        string(JSON type TYPE "${numeric}" surface vertices_xyz 0 2)
        equal("${type}" NULL "Source masked z serializes null")
    endif()
    if(NOT SVG_ENABLED)
        reject_svg("svg-${kind}" --kind "${kind}" ${extra} --run-id "${kind}")
        invoke("repeat-numeric-${kind}" 0 illustrate --kind "${kind}" ${extra})
        equal("${output}" "${numeric}" "Rejected SVG leaves numeric geometry unchanged")
        continue()
    endif()
    invoke("svg-${kind}" 0 illustrate --kind "${kind}" ${extra} --format svg --run-id "${kind}")
    field("${output}" "${kind}" run_id)
    check_artifact_execution("${root}" "${kind}" "${blob}"
        illustrate --kind "${kind}" ${extra} --format svg --run-id "${kind}")
    artifact_field("${recorded_artifact_invocation}" "${kind}" effective_config kind)
    artifact_field("${recorded_artifact_invocation}" svg effective_config format)
    artifact_field("${recorded_artifact_invocation}" generated_from_source_and_config inputs kind)
    string(JSON helpers GET "${numeric}" helper_source_blobs)
    artifact_field("${recorded_artifact_invocation}" "${helpers}" inputs helper_source_blob_shas)
    string(JSON mat_count LENGTH "${recorded_artifact_invocation}" inputs mat_files)
    equal("${mat_count}" 0 "Illustration does not read MAT")
    if(kind STREQUAL harmonic)
        artifact_field("${recorded_artifact_invocation}" 3 effective_config degree)
        artifact_field("${recorded_artifact_invocation}" 2 effective_config order)
    endif()
    field("${output}" illustration.json plot_files 0)
    field("${output}" illustration.svg plot_files 1)
    file(GLOB files RELATIVE "${root}/output/${kind}" "${root}/output/${kind}/*")
    equal("${files}" "execution.json;illustration.json;illustration.svg;invocation.json" "Numeric data, SVG and two execution records")
    file(READ "${root}/output/${kind}/illustration.json" published)
    equal("${published}" "${numeric}" "Headless and plotted geometry byte-identical")
    file(READ "${root}/output/${kind}/illustration.svg" svg)
    string(REGEX MATCHALL "<polygon " polygons "${svg}")
    list(LENGTH polygons count)
    equal("${count}" "${faces}" "All visible triangles")
    file(SHA256 "${root}/output/${kind}/illustration.svg" before)
    invoke("duplicate-${kind}" 6 illustrate --kind "${kind}" ${extra} --format svg --run-id "${kind}")
    field("${diagnostic}" OutputExists error_code)
    file(SHA256 "${root}/output/${kind}/illustration.svg" after)
    equal("${after}" "${before}" "No overwrite of previous result")
endforeach()
if(SVG_ENABLED)
    invoke(auto-id 0 illustrate --kind harmonic --degree 0 --order 0 --format svg)
    string(JSON auto_id GET "${output}" run_id)
    if(NOT auto_id MATCHES "^[A-Za-z0-9_-]+$")
        message(SEND_ERROR "Unsafe automatic RunId")
    endif()
    if(NOT EXISTS "${root}/output/${auto_id}/illustration.svg")
        message(SEND_ERROR "Automatic RunId publication missing")
    endif()
else()
    reject_svg(auto-id --kind harmonic --degree 0 --order 0)
endif()
foreach(figure IN ITEMS 3 4)
    set(id "paper${figure}")
    set(source_blob c6bdbff07cdfff796c105f299fb728b15783ac7c)
    if(figure EQUAL 4)
        set(source_blob d7f97e0fe15c761f33f6ebd152610ec4144561e9)
    endif()
    invoke("${id}-data" 0 paper-figure --figure "${figure}" --format data --run-id "${id}")
    check_artifact_execution("${root}" "${id}" "${source_blob}" paper-figure --figure "${figure}" --format data --run-id "${id}")
    field("${recorded_artifact_invocation}" "${figure}" effective_config figure)
    field("${recorded_artifact_invocation}" new_cpp_run inputs kind)
    field("${output}" geometry-A.json evidence_files 0)
    field("${output}" geometry-B.json evidence_files 1)
    field("${output}" case-counts.json evidence_files 2)
    file(READ "${root}/output/${id}/case-counts.json" counts)
    field("${counts}" 2 attempted)
    field("${counts}" 2 completed)
    field("${counts}" 0 failed)
    foreach(side IN ITEMS A B)
        file(READ "${root}/output/${id}/geometry-${side}.json" geometry)
        if(figure EQUAL 3)
            if(side STREQUAL A)
                set(kind circle)
                set(azimuth 60)
                set(elevation 24)
            else()
                set(kind sinusoidal)
                set(azimuth 55)
                set(elevation 22)
            endif()
            field("${geometry}" "${kind}" kind)
            field("${geometry}" "${azimuth}" view azimuth_degrees)
            field("${geometry}" "${elevation}" view elevation_degrees)
            field("${geometry}" "10.1371/journal.pone.0128413.g003 (estimated from published axes)" view source)
            string(JSON stripped REMOVE "${geometry}" view)
            string(SHA256 digest "${stripped}")
            equal("${digest}" "${archive_${kind}}" "All trajectory/mesh values match the archive illustration")
        else()
            if(side STREQUAL A)
                set(degree 1)
            else()
                set(degree 2)
            endif()
            field("${geometry}" "${degree}" harmonic degree)
            field("${geometry}" 1 harmonic order)
            field("${geometry}" 40 view azimuth_degrees)
            field("${geometry}" 30 view elevation_degrees)
        endif()
    endforeach()
    if(NOT SVG_ENABLED)
        invoke("${id}-no-svg" 7 paper-figure --figure "${figure}" --format svg --run-id "${id}-svg")
        field("${diagnostic}" BackendUnavailable error_code)
        if(EXISTS "${root}/output/${id}-svg")
            message(SEND_ERROR "SVG-disabled paper request reserved a RunId")
        endif()
        continue()
    endif()
    invoke("${id}-svg" 0 paper-figure --figure "${figure}" --format svg --run-id "${id}-svg")
    check_artifact_execution("${root}" "${id}-svg" "${source_blob}" paper-figure --figure "${figure}" --format svg --run-id "${id}-svg")
    field("${output}" "fig${figure}.svg" evidence_files 3)
    foreach(side IN ITEMS A B)
        file(SHA256 "${root}/output/${id}/geometry-${side}.json" numeric_sha)
        file(SHA256 "${root}/output/${id}-svg/geometry-${side}.json" drawn_sha)
        equal("${numeric_sha}" "${drawn_sha}" "Data and SVG deliver identical panel geometry")
    endforeach()
    file(READ "${root}/output/${id}-svg/fig${figure}.svg" pair)
    if(NOT pair MATCHES "sceneA" OR NOT pair MATCHES "sceneB")
        message(SEND_ERROR "Missing paper viewport")
    endif()
    if(figure EQUAL 3)
        foreach(axis IN ITEMS x y z)
            string(REGEX MATCHALL "data-axis=\"${axis}\"" axes "${pair}")
            list(LENGTH axes count)
            equal("${count}" 2 "One ${axis} axis per trajectory panel")
        endforeach()
        string(REGEX MATCHALL "data-trajectory-segment=" segments "${pair}")
        list(LENGTH segments count)
        equal("${count}" 1198 "Two paths, each joining 600 source points")
    elseif(NOT pair MATCHES "degree=2 order=1" OR pair MATCHES "data-axis=")
        message(SEND_ERROR "Fig. 4 needs harmonic identity and the source axis-off layout")
    endif()
endforeach()
file(GLOB original_files "${root}/origin/*")
equal("${original_files}" "" "Original input sandbox remains untouched")
get_property(count GLOBAL PROPERTY ILLUSTRATION_CALLS)
message(STATUS "illustrations real CLI calls=${count}; source=${SOURCE_SHA}; evidence=${root}")
